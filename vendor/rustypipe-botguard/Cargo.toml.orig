[package]
name = "rustypipe-botguard"
version = "0.1.2"
rust-version = "1.70.0"
edition = "2021"
authors = ["ThetaDev <thetadev@magenta.de>"]
license = "MIT"
description = "Run YouTube Botguard challenges and generate PO tokens"
repository = "https://codeberg.org/ThetaDev/rustypipe-botguard"
keywords = ["youtube", "video", "music"]
categories = ["api-bindings", "multimedia"]

include = ["/src", "/js", "/README.md", "/CHANGELOG.md", "/LICENSE"]

[dependencies]
clap = { version = "4.5.27", features = ["derive"] }
brotli = "8.0.0"
serde_json = "1.0.137"
serde = { version = "1", features = ["derive"] }
tokio = { version = "1.43.0", features = ["macros", "rt-multi-thread"] }
reqwest = { version = "0.12.0", default-features = false, features = ["json", "gzip", "brotli", "charset", "http2", "system-proxy", "rustls-tls-webpki-roots"] }
data-encoding = "2.3.3"
once_cell = "1.17.1"
thiserror = "2.0.0"
time = { version = "0.3.37", features = ["serde", "serde-well-known"] }
byteorder = "1.5.0"
log = "0.4.25"
env_logger = "0.11.6"
urlencoding = "2.1.3"
dirs = "6.0.0"
const_format = "0.2.33"

deno_core = { version = "0.331.0", default-features = false, features = [
    "v8_use_custom_libcxx",
] }
deno_console = { version = "0.187.0" }
deno_url = { version = "0.187.0" }
deno_web = { version = "0.218.0" }
deno_webidl = { version = "0.187.0" }

[dev-dependencies]
temp_testdir = "0.2.3"

[profile.release]
codegen-units = 1
incremental = true
lto = true
opt-level = "z"
strip = "symbols"
